# ─────────────────────────────────────────────────────────────────────────────
# AI Travel Savings Agent - Environment Variables
# Copy this file to .env and fill in the values you have.
# ─────────────────────────────────────────────────────────────────────────────

# ── Duffel API (REQUIRED for live flight search) ──────────────────────────────
# Sign up free at https://duffel.com - sandbox key works out of the box
DUFFEL_API_KEY=duffel_live_xxxxxxxxxxxxxxxxxxxx

# ── LLM Provider (at least ONE recommended for AI insights) ──────────────────
# Groq - free tier, fastest inference (llama-3.3-70b-versatile)
# https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Anthropic Claude - claude-haiku-4-5 (paid)
# https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# OpenAI - gpt-4o-mini (paid)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Google ADK / Gemini (used by adk_travel_agent)
GOOGLE_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxx
# Optional: change this if your Google project has quota on a different model.
GOOGLE_ADK_MODEL=gemini-flash-latest

# ─────────────────────────────────────────────────────────────────────────────
# Priority order for the web app: Groq → Anthropic → OpenAI  (first key found is used)
# Google ADK uses GOOGLE_API_KEY/Gemini when running `adk web`.
# The fallback chain is automatic - no code changes needed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Hotel APIs (optional — adds more sources beyond Booking.com scraping) ─────

# SerpAPI – Google Hotels (100 free searches/month, no credit card)
# Sign up: https://serpapi.com/users/sign_up
SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxx

# RapidAPI – unlocks Booking.com API + TripAdvisor (500 free/month each)
# Sign up: https://rapidapi.com/auth/sign-up  → subscribe to:
#   • booking-com15.p.rapidapi.com  (search for free)
#   • tripadvisor16.p.rapidapi.com  (search for free)
RAPIDAPI_KEY=xxxxxxxxxxxxxxxxxxxx
# Optional: set this if your RapidAPI Priceline subscription uses a different host.
PRICELINE_RAPIDAPI_HOST=priceline-com2.p.rapidapi.com
# Optional: try multiple subscribed Priceline hosts in order.
# PRICELINE_RAPIDAPI_HOSTS=priceline-com2.p.rapidapi.com,priceline-com-provider.p.rapidapi.com,priceline-com.p.rapidapi.com
# Optional: set this if priceline-com2 docs show a different hotel search path.
# The provided com2 docs use /hotels/search?locationId=<id>.
PRICELINE_COM2_HOTEL_SEARCH_PATH=/hotels/search

# ── Frontend backend URL (optional) ───────────────────────────────────────────
# Leave unset for local Next.js rewrites. Set when the backend runs elsewhere.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
